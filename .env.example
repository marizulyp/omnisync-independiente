# Copiar este archivo a .env y completar los valores

# Base de datos PostgreSQL
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/centro_veterinario?schema=public"

# Generar con: openssl rand -base64 32
AUTH_SECRET="SECRETO_ALEATORIO_MINIMO_32_CARACTERES"

# Usar la dirección con la que cada equipo entra (localhost o la IP del servidor).
# Necesario para que la app funcione desde otros computadores, tablets y celulares de la red local.
AUTH_TRUST_HOST=true
